# the difference between herbivore and carnivore are just these variables
# initSize:
#   the size a dino grows to before egging (also passes enough
#   calories to egg so new dino can grow to this size right away
# initMinMoves:
#   make sure after growing or egging, I have enough calories left
#   over for this many moves
# initFoodDist:
#   how far away I'm willing to go when first searching for food (this
#   temporarily increases if I can't find any food)
# whenbumpXXXX:
#   the 3 init variables grow as we have more live dinos.  every time
#   we get this many dinos, bump them
# pctDistBeforeLooking:
#   cover this fraction of the distance to food before looking
#   1 means don't look on the way to food
# foodLargerBy:
#   only go after food that is this much larger than me or less
if len(sys.argv) > 1 and sys.argv[1][0] == 'h':
  myType = EntityType.HERBIVORE
  foodType = EntityType.PLANT
  initSize = 4
  initMinMoves = 7
  initFoodDist = 5
  # whenbumpSize controls how fast the dinos multiply
  #   14 was good before server started limiting simultaneous connections
  #   7 prevents failed connection after server started limiting
  whenbumpSize = random.randint(7,14)
  whenbumpMinMoves = 16
  whenbumpFoodDist = 6
  pctDistBeforeLooking = 1
  foodLargerBy = 0
  widenSearchOnFail = 1
elif len(sys.argv) > 1 and sys.argv[1][0] == 'c':
  myType = EntityType.CARNIVORE
  foodType = EntityType.HERBIVORE
  initSize = 25
  initMinMoves = 20
  initFoodDist = 10
  whenbumpSize = 100
  whenbumpMinMoves = 100
  whenbumpFoodDist = 100
  pctDistBeforeLooking = 0.5
  foodLargerBy = 40
  widenSearchOnFail = 2
else:
  print 'usage:', sys.argv[0], '[h or c] [nogui]'
  quit()

if len(sys.argv) > 2 and sys.argv[2] == 'nogui':
  gui = 0
else:
  gui = 1

def movePoint(dir,x,y):
  if dir == 0 or dir == 1 or dir == 7:
    y=y-1
  if dir == 3 or dir == 4 or dir == 5:
    y=y+1
  if dir == 5 or dir == 6 or dir == 7:
    x=x-1
  if dir == 1 or dir == 2 or dir == 3:
    x=x+1
  return (x,y)
 
