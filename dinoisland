      self.canv.delete(self.popupBack)
      self.canv.delete(self.popupTxt)
    except:
      pass
    xPix = int(event.x + self.xscrollbar.get()[0]*self.mapSize*2*pixSize)-1
    yPix = int(event.y + self.yscrollbar.get()[0]*self.mapSize*2*pixSize)-1
    x = (xPix / pixSize) - self.mapSize
    y = (yPix / pixSize) - self.mapSize
    if (x,y) in map.map:
      ent = map.map[x,y]
      if ent.type == EntityType.PLANT:
        msg = 'Plant\n'
      elif ent.type == EntityType.HERBIVORE:
        msg = 'Herbivore\n'
      elif ent.type == EntityType.CARNIVORE:
        msg = 'Carnivore\n'
      elif ent.type == EntityType.IMPASSABLE:
        msg = 'Rock\n'
      msg = msg + 'species=' + ent.species + '\n'
      if ent.species == 'You' and (x,y) in map.spaceMap:
        dino = map.spaceMap[x,y]
        msg = msg + 'size=' + str(dino.state.size) + '\n'
        msg = msg + 'calories=' + str(dino.state.calories) + '\n'
      else:
        msg = msg + 'size=' + str(ent.size) + '\n'
      self.popupBack = self.canv.create_rectangle(xPix,yPix,xPix+300,yPix+70,
                                                  fill='#cccccc')
      self.popupTxt = self.canv.create_text(xPix+5,yPix+5,fill='#000000',
                                            anchor=NW,text=msg)

